# poc-app 環境変数(値は空欄。各自 .env.local にコピーして記入する)
# .env.local はコミットしない・エージェントも読み書きしない(CLAUDE.md方針)

# Supabaseプロジェクトの URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の anon public key(公開前提の値。実際のアクセス制御はRLSが担う)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# メールリンクのリダイレクト先(開発は http://localhost:3000 / 本番は公開URL)
NEXT_PUBLIC_SITE_URL=

# 以下は次段(完了報告の下書き・現場メモの構造化)でLLMを導入する場合にのみ使用。
# 初手PoC(台帳+地図+集計)では未使用。サーバー側(app/api/**)でのみ読み、
# クライアントに一切渡さないこと(docs/SPEC.md §8・CLAUDE.md参照)。
# OPENAI_API_KEY=
